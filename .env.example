# ==============================================================================
# ARCHIVO PLANTILLA DE CONFIGURACIÓN DE ENTORNO (ESENCIA)
# Copie este archivo como '.env' en la raíz de su proyecto y rellene las claves.
# ==============================================================================

# === Configuración del Proyecto ===
PROJECT_NAME=esencia
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY_DJANGO=your_django_secret_key_here
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.esencia.local
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Seguridad y JWT ===
JWT_ACCESS_COOKIE_NAME=esencia_access_token
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=your_jwt_signing_key_here
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=3600
JWT_COOKIE_SECURE=0
JWT_COOKIE_SAMESITE=Lax

# === Base de Datos (PostgreSQL) ===
POSTGRES_DB=esencia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Pasarela de Pagos (Stripe) ===
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
SITE_URL=http://localhost:5173

# === Configuración de Email (Resend) ===
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your_resend_smtp_password_here
DEFAULT_FROM_EMAIL=info@esenciajoyeria.app

# === Redis y Tareas en Segundo Plano ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# === Frontend ===
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api

# === Calidad de Código (SonarCloud) ===
SONAR_TOKEN=your_sonar_token_here
SONAR_PROJECT_KEY=celiasuaco_esencia
SONAR_ORGANIZATION=celiasuaco

# === Inteligencia Artificial ===
GEMINI_API_KEY=your_gemini_api_key_here